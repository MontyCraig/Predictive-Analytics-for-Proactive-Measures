# Alpha Vantage API key
# Get a free key from https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# General configuration
OUTPUT_DIR=output
LOG_LEVEL=INFO
DATA_FILE=

# Basic model configuration
MODEL_TYPE=sarima  # Options: sarima, prophet, auto_arima, exp_smoothing
TRAIN_SIZE=0.8
TEST_SIZE=0.2
RANDOM_STATE=42

# SARIMA model configuration
# Order parameters (p, d, q)
SARIMA_P=1
SARIMA_D=1
SARIMA_Q=1
# Seasonal order parameters (P, D, Q, s)
SARIMA_P_SEASONAL=1
SARIMA_D_SEASONAL=1
SARIMA_Q_SEASONAL=1
SARIMA_S=12
# Model behavior
SARIMA_ENFORCE_STATIONARITY=True
SARIMA_ENFORCE_INVERTIBILITY=True

# Prophet model configuration
PROPHET_YEARLY_SEASONALITY=True
PROPHET_WEEKLY_SEASONALITY=True
PROPHET_DAILY_SEASONALITY=False
PROPHET_SEASONALITY_MODE=additive  # Options: additive, multiplicative
PROPHET_CHANGEPOINT_PRIOR_SCALE=0.05
PROPHET_SEASONALITY_PRIOR_SCALE=10.0

# Auto ARIMA model configuration
AUTO_ARIMA_MAX_P=5
AUTO_ARIMA_MAX_D=2
AUTO_ARIMA_MAX_Q=5
AUTO_ARIMA_MAX_P_SEASONAL=2
AUTO_ARIMA_MAX_D_SEASONAL=1
AUTO_ARIMA_MAX_Q_SEASONAL=2
AUTO_ARIMA_M=7  # Seasonal periodicity
AUTO_ARIMA_SEASONAL=True
AUTO_ARIMA_STEPWISE=True

# Exponential Smoothing model configuration
# Options for trend and seasonal: None, add, mul
EXP_SMOOTHING_TREND=add
EXP_SMOOTHING_SEASONAL=add
EXP_SMOOTHING_SEASONAL_PERIODS=7  # Set to None to auto-detect
EXP_SMOOTHING_DAMPED_TREND=False 